{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creativate Dev-Shell",
  "mainBinaryName": "Creativate Dev-Shell",
  "version": "0.1.0",
  "identifier": "tech.creativate.devshell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Creativate Dev-Shell",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
