# c:node Sandbox (cnode-prod EC2) — nach .env.sandbox kopieren und Werte setzen.
# NIEMALS echte Secrets committen (.env* ist gitignored).

TENANT=cnode

# --- LLM: Gemini (dünner Proxy hält den Key; nie im Browser) ---
DEFAULT_PROVIDER=gemini
GOOGLE_API_KEY=            # PFLICHT — Google AI Studio Key (Gemini Flash)
GEMINI_MODEL=gemini-flash-latest

# --- IP-Abriegelung: nur eigene Ebene, kein NENA/market/mesh ---
PUBLIC_DEMO=1

# --- Zwei-Host-Setup (Shell + API), same-site c-node.ai ---
PUBLIC_BASE_URL=https://api.try.c-node.ai
CORS_ORIGINS=https://try.c-node.ai
COOKIE_SECURE=true

# --- Rate-Limit / Token-Cap (nur bei PUBLIC_DEMO aktiv) ---
RL_PER_MIN=20               # LLM-Requests je IP/Minute (Burst-Schutz)
RL_PER_DAY=200              # LLM-Requests je IP/Tag
RL_TOKENS_PER_DAY=150000    # Token-Budget je IP/Tag (Kosten-Deckel)
RL_EST_TOKENS_PER_REQ=1500  # Schätzung Tokens/Anfrage (konservativ, streaming-sicher)

# --- StartupScout: GitHub-Token (optional, empfohlen) ---
# Ohne Token: nur Repo-Suche, KEIN Region-Filter (DACH/DE nicht erzwingbar), niedrige Limits.
# Mit Token: Owner-Location wird angereichert → echte Region-Filterung + höhere Rate-Limits.
# Feingranularer Read-only-Token reicht (public_repo/read). https://github.com/settings/tokens
GITHUB_TOKEN=

# --- optional: programmatischer Zugriff (SDK) ---
# CNODE_API_KEYS=sdk:<openssl rand -hex 24>:member

# --- Monetarisierung: Upsell + Entitlement-Flip (Stripe/IAP) ---
# Upgrade-Ziele im Sandbox-Banner (leer → Sales-/mailto-Fallback).
STRIPE_LINK_PRO=            # Stripe Payment-Link „NENA Intelligence" (Pro)
STRIPE_LINK_TEAM=           # Stripe Payment-Link „Eigene Instanz" (Team)
SALES_CONTACT_URL=         # White-Label / Enterprise → HubSpot-Meeting o. mailto
# Webhook: setzt intel=true + Tier je Tenant (client_reference_id am Checkout).
STRIPE_WEBHOOK_SECRET=      # whsec_… (leer nur für lokalen Test — dann unsigniert!)
# Price-ID → Tier, wenn keine Metadata product_tier am Objekt hängt.
# STRIPE_PRICE_TIERS=price_XXX:pro,price_YYY:team
