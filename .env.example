# Creativate Dev-Shell — copy to .env for local overrides (all optional).

# Model-Router → lokales OSS-LLM (EU-souverän, default)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Modell-Toggle: Claude als Fallback/Vergleich (optional, leer = nur OSS)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Frontend → Gateway
VITE_GATEWAY_URL=http://localhost:8080

# --- Microsoft / Outlook (Graph) OAuth — Azure-App (optional, für Outlook-Connector) ---
# App-Registrierung: portal.azure.com → App registrations. Redirect-URI (Web):
#   http://localhost:8080/integrations/microsoft/oauth/callback
# Delegated Permissions: offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
