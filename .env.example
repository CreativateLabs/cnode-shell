# c:node Shell — copy to .env for local overrides (all optional). `.env` is gitignored.

# --- LLM -------------------------------------------------------------------
# Default: local Ollama (sovereign, offline). Cloud providers are optional (bring your own key).
# Provider for new chats: ollama | gemini | claude
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
DEFAULT_MODEL=qwen2.5:7b

# Gemini key (DEFAULT_PROVIDER=gemini)
GOOGLE_API_KEY=
# Anthropic key (DEFAULT_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Auth --------------------------------------------------------------------
# Set your own values before exposing the stack beyond localhost.
# AUTH_SECRET=                     # e.g. `openssl rand -base64 48`
# SUPERADMIN_EMAIL=                # your admin email (magic-link bootstrap)

# --- Frontend → Gateway --------------------------------------------------------
VITE_GATEWAY_URL=http://localhost:8080

# --- Microsoft / Outlook (Graph) OAuth — optional, for the Outlook connector ---
# App registration: portal.azure.com → App registrations. Redirect URI (Web):
#   http://localhost:8080/integrations/microsoft/oauth/callback
# Delegated permissions: offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# --- Google (Gmail / Drive) OAuth — optional, for the Google connector ----------
# Redirect URI: http://localhost:8080/integrations/google/oauth/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
